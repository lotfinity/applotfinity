# COPY LOCALLY TO .env, fill in a new secret, NEVER commit .env.
# Generate a secret with: python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=REPLACE_WITH_A_UNIQUE_RANDOM_VALUE
DJANGO_ALLOWED_HOSTS=hello-from.lotfinity.tech
DJANGO_CSRF_TRUSTED_ORIGINS=https://hello-from.lotfinity.tech
# Set to 1 ONLY when your trusted proxy rewrites X-Forwarded-Proto.
DJANGO_TRUST_PROXY_SSL_HEADER=0
# Default 3600. Increase only once the HTTPS domain has been verified.
DJANGO_HSTS_SECONDS=3600
